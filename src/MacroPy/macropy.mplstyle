# MacroPy figure style: notebook context, serif type.
# Generated by MacroPy.style._mplstyle_text(); do not edit by hand.
# Use with plt.style.use("MacroPy.macropy").

figure.dpi: 110
figure.figsize: 8.0, 4.5
figure.titlesize: 13.0
figure.titleweight: bold
savefig.dpi: 200
savefig.bbox: tight
savefig.pad_inches: 0.05
font.family: serif
mathtext.fontset: dejavuserif
font.size: 11.0
axes.titlesize: 12.0
axes.labelsize: 11.0
xtick.labelsize: 10.0
ytick.labelsize: 10.0
legend.fontsize: 10.0
axes.titleweight: bold
axes.titlecolor: 233746
axes.labelcolor: 4A4A4A
axes.edgecolor: 4A4A4A
axes.linewidth: 0.8
axes.spines.top: False
axes.spines.right: False
axes.grid: True
axes.axisbelow: True
axes.prop_cycle: cycler('color', ['1F3D5C', 'E78033', '009E73', 'B0413E', '56B4E9', 'CC79A7', 'F0E442', '7F7F7F'])
grid.color: DDDDDD
grid.linewidth: 0.6
xtick.color: 4A4A4A
ytick.color: 4A4A4A
lines.linewidth: 1.5
legend.frameon: False
date.converter: concise
